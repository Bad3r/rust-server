# Whitelist: everything else is steamcmd, Carbon, server, or tool output, world state, or a secret (.rcon-password,
# server/carbon/config.webpanel.json, server/server/pve/cfg/relay_cfg.json, and, once it holds a Steam API key,
# server/carbon/configs/ImageLibrary.json). Git cannot re-include a file under an ignored directory, so every parent
# directory of a tracked file is re-included on its own line.
/*
!/.gitignore
!/.github/
!/CLAUDE.md
!/LICENSE
!/README.md
!/flake.lock
!/flake.nix
!/scripts/
!/start.sh
!/harmony/

!/server/
/server/*

!/server/server/
/server/server/*
!/server/server/pve/
/server/server/pve/*
!/server/server/pve/cfg/
/server/server/pve/cfg/*
!/server/server/pve/cfg/server.cfg

!/server/carbon/
/server/carbon/*
!/server/carbon/config.json
!/server/carbon/config.profiler.json
!/server/carbon/modules/
/server/carbon/modules/*/*
!/server/carbon/modules/*/config.json
!/server/carbon/plugins/
/server/carbon/plugins/*
!/server/carbon/plugins/AutoDoors.cs
!/server/carbon/plugins/BuildingSkins.cs
!/server/carbon/plugins/ImageLibrary.cs
!/server/carbon/plugins/MonumentAddons.cs
!/server/carbon/plugins/MonumentFinder.cs
!/server/carbon/plugins/Skins.cs
!/server/carbon/plugins/SkinsCatalog.cs
!/server/carbon/plugins/SmeltSpeed.cs
!/server/carbon/configs/
/server/carbon/configs/*
!/server/carbon/configs/AutoDoors.json
!/server/carbon/configs/BuildingSkins.json
!/server/carbon/configs/MonumentAddons.json
!/server/carbon/configs/MonumentFinder.json
!/server/carbon/configs/Skins.json
!/server/carbon/configs/SmeltSpeed.json
!/server/carbon/data/
/server/carbon/data/*
!/server/carbon/data/MonumentAddons/
/server/carbon/data/MonumentAddons/*
!/server/carbon/data/MonumentAddons/Default.json
