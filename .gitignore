# Whitelist: everything else is steamcmd, Carbon, server, or tool output, world state, or a secret (.rcon-password,
# server/carbon/config.webpanel.json, server/server/pve/cfg/relay_cfg.json). Git cannot re-include a file under an
# ignored directory, so every parent directory of a tracked file is re-included on its own line.
/*
!/.gitignore
!/CLAUDE.md
!/LICENSE
!/flake.lock
!/flake.nix
!/start.sh
!/harmony/

!/server/
/server/*

!/server/server/
/server/server/*
!/server/server/pve/
/server/server/pve/*
!/server/server/pve/cfg/
/server/server/pve/cfg/*
!/server/server/pve/cfg/server.cfg

!/server/carbon/
/server/carbon/*
!/server/carbon/config.json
!/server/carbon/config.profiler.json
!/server/carbon/modules/
/server/carbon/modules/*/*
!/server/carbon/modules/*/config.json
!/server/carbon/plugins/
/server/carbon/plugins/*
!/server/carbon/plugins/AutoDoors.cs
!/server/carbon/plugins/SmeltSpeed.cs
!/server/carbon/configs/
/server/carbon/configs/*
!/server/carbon/configs/AutoDoors.json
!/server/carbon/configs/SmeltSpeed.json
